{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ProductCatalog.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ProductCatalog.Api/bin/Debug/net10.0/ProductCatalog.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ProductCatalog.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Persistence__Provider": "Mock"
      }
    }
  ]
}
